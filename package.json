{
  "name": "forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "node scripts/e2e.mjs http://localhost:4173 e2e-shots --offline",
    "e2e:webkit": "node scripts/e2e.mjs http://localhost:4173 e2e-shots-webkit --webkit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.65.0",
    "typescript": "~5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
